programa {
  funcao inicio() {
    inteiro quant_alunos
    real nota_a1, nota_a2, nota_a3, nota_a4, nota_a5  
    real media
    cadeia nome_escola
    nome_escola="Escola Raio de Sol"
    nota_a1 = 8
    nota_a2 = 7.5
    nota_a3 = 9.5
    nota_a4 = 6.75
    nota_a5 = 8.25
    quant_alunos=5
    media=(nota_a1 + nota_a2 + nota_a3 + nota_a4 + nota_a5)/quant_alunos
    escreva("A média é: ",media)
  }
}
