programa {
  funcao inicio() {
    inteiro numero, antecessor, sucessor
    escreva("Antecessor e sucessor de um número\n")
    escreva("Digite um número: ")
    leia(numero)
    antecessor=numero-1
    sucessor=numero+1
    escreva("\nAntecessor: ",antecessor)
    escreva("\nSucessor: ",sucessor)
  }
}
